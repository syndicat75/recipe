rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 인증 여부 검사 헬퍼
    function isSignedIn() {
      return request.auth != null;
    }

    // 관리자 권한 검사 헬퍼 (공식 관리자 계정 syndicat@eugenes.co.kr 또는 admins 컬렉션 등록 UID)
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'syndicat@eugenes.co.kr' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // 1. 최상위 공개 레시피 컬렉션 (/recipes/{recipeId}):
    // 모든 방문자(비로그인 및 로그인 사용자)는 자유롭게 조회 가능
    // 등록/수정/삭제는 오직 인증된 관리자(Admin)만 허용
    match /recipes/{recipeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 2. 사용자 개인 데이터 (users/{userId}):
    // 개인 레시피(users/{userId}/recipes/{recipeId}), 즐겨찾기/메모(users/{userId}/settings/data),
    // 장보기 목록(users/{userId}/shoppingItems/{itemId})
    // 오직 본인(request.auth.uid == userId)만 읽기 및 쓰기 가능
    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
      
      match /recipes/{recipeId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }

      match /{allSubcollections=**} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // 3. 관리자 권한 관리 컬렉션
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 4. 가족 공유 공간 보안 규칙
    // 가족 구성원 확인 헬퍼
    function isFamilyMember(familyId) {
      return isSignedIn() && exists(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid));
    }

    // 가족 대표(Owner) 확인 헬퍼
    function isFamilyOwner(familyId) {
      return isSignedIn() && (
        (exists(/databases/$(database)/documents/families/$(familyId)) &&
         get(/databases/$(database)/documents/families/$(familyId)).data.ownerId == request.auth.uid) ||
        (exists(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid)).data.role == 'owner')
      );
    }

    // 4-1. /families/{familyId}
    match /families/{familyId} {
      // 단일 공간 조회는 로그인 사용자 허용 (초대 코드 참여 시 상태 검증 지원), 전체 목록 쿼리/list는 금지
      allow get: if isSignedIn();
      allow list: if false;
      // 신규 가족 생성: 로그인 사용자 && ownerId가 본인 UID와 일치
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      // 가족 정보 수정은 기존 대표(owner)만 가능
      allow update: if isFamilyOwner(familyId);
      // 물리적 삭제는 비허용 (soft-delete 사용)
      allow delete: if false;

      // 4-2. /families/{familyId}/members/{memberUid}
      match /members/{memberUid} {
        // 구성원은 전체 구성원 목록 조회 가능
        allow read: if isFamilyMember(familyId);
        // 생성 권한 (가족 생성 vs 초대 가입 분리):
        // 1) 신규 가족 생성 트랜잭션: 본인 UID + owner 역할 + families 문서의 ownerId가 본인인 경우 (getAfter 지원)
        // 2) 초대 코드를 통한 일반 가입: 본인 UID + member 역할 + 해당 family 문서가 실제로 존재하는 경우
        // 3) 기존 가족 대표(owner)가 구성원을 추가하는 경우
        allow create: if isSignedIn() && (
          (request.auth.uid == memberUid && request.resource.data.role == 'owner' && (
            (exists(/databases/$(database)/documents/families/$(familyId)) &&
             get(/databases/$(database)/documents/families/$(familyId)).data.ownerId == request.auth.uid) ||
            (existsAfter(/databases/$(database)/documents/families/$(familyId)) &&
             getAfter(/databases/$(database)/documents/families/$(familyId)).data.ownerId == request.auth.uid)
          )) ||
          (request.auth.uid == memberUid && request.resource.data.role == 'member' &&
           exists(/databases/$(database)/documents/families/$(familyId))) ||
          isFamilyOwner(familyId)
        );
        // 수정: 본인은 프로필(name, avatar)만 수정 가능(role 임의 변경 불가), owner는 대표 권한 위임 등 role 수정 가능
        allow update: if isSignedIn() && (
          (request.auth.uid == memberUid && request.resource.data.role == resource.data.role) ||
          isFamilyOwner(familyId)
        );
        // 탈퇴/추방: 본인 나가기 또는 owner에 의한 추방 허용
        allow delete: if isSignedIn() && (
          request.auth.uid == memberUid ||
          isFamilyOwner(familyId)
        );
      }

      // 4-3. /families/{familyId}/recipeRefs/{recipeId}
      // 가족 구성원만 공유 레시피 목록 읽기/쓰기 가능
      match /recipeRefs/{recipeId} {
        allow read, write: if isFamilyMember(familyId);
      }

      // 4-4. /families/{familyId}/mealPlanEntries/{entryId}
      // 가족 구성원만 주간 식단표 읽기/쓰기 가능
      match /mealPlanEntries/{entryId} {
        allow read, write: if isFamilyMember(familyId);
      }

      // 4-5. /families/{familyId}/shoppingItems/{itemId}
      // 가족 구성원만 장보기 목록 읽기/쓰기 가능
      match /shoppingItems/{itemId} {
        allow read, write: if isFamilyMember(familyId);
      }
    }

    // 5. /familyInvites/{inviteCode}
    match /familyInvites/{inviteCode} {
      // 초대 코드 단일 조회만 허용 (전체 목록 쿼리/list 금지)
      allow get: if isSignedIn();
      allow list: if false;
      // 생성: 신규 가족 생성 트랜잭션 또는 기존 owner에 의한 초대 코드 생성 (getAfter 지원)
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid && (
        (exists(/databases/$(database)/documents/families/$(request.resource.data.familyId)) &&
         get(/databases/$(database)/documents/families/$(request.resource.data.familyId)).data.ownerId == request.auth.uid) ||
        (existsAfter(/databases/$(database)/documents/families/$(request.resource.data.familyId)) &&
         getAfter(/databases/$(database)/documents/families/$(request.resource.data.familyId)).data.ownerId == request.auth.uid)
      );
      // 수정/비활성화/삭제: 해당 가족 대표(owner)만 가능
      allow update, delete: if isSignedIn() && isFamilyOwner(resource.data.familyId);
    }

    // 6. 카테고리 관리 컬렉션 (/recipeCategories/{categoryId})
    // 조회: 누구나 가능 (비로그인, 로그인 모두)
    // 등록/수정/삭제: 관리자(isAdmin())만 가능
    match /recipeCategories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}

