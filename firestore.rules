rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Top-level public recipes collection:
    // Anyone (guests and logged-in users) can read and search recipes.
    // Writes (create, update, delete) are permitted only for authenticated admin.
    match /recipes/{recipeId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 2. Private user settings, bookmarks, notes, and shopping list under users/{userId}
    // Each user can only read and write their own data.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      match /{allSubcollections=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}

